---
interface Props { color?: 'blue' | 'gray' | 'green'; }
const { color = 'blue' } = Astro.props;
const colors = {
  blue: 'bg-blue-100 text-blue-700',
  gray: 'bg-gray-100 text-gray-700',
  green: 'bg-green-100 text-green-700',
};
---
<span class={`inline-block px-2.5 py-1 text-xs font-medium rounded-full ${colors[color]}`}>
  <slot />
</span>