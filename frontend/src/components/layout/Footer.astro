    <div>
      <p class="font-bold text-lg text-blue-600 mb-2">Agency</p>
      <p class="text-sm text-gray-600">Разработка сайтов, дизайн, маркетинг.</p>
    </div>

    <div>
      <p class="font-semibold mb-3">Навигация</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/services" class="hover:text-blue-600">Услуги</a></li>
        <li><a href="/blog" class="hover:text-blue-600">Блог</a></li>
        <li><a href="/about" class="hover:text-blue-600">О нас</a></li>
        <li><a href="/contact" class="hover:text-blue-600">Контакты</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold mb-3">Контакты</p>
