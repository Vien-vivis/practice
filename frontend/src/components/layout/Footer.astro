---
const year = new Date().getFullYear();
---
<footer class="bg-[#101D3A] pt-16 pb-8 font-inter text-white">
  <div class="max-w-[1184px] mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="md:col-span-2">
        <a href="/" class="font-manrope font-extrabold text-[24px] text-white tracking-tight flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-[#1760F5] rounded-lg flex items-center justify-center text-white text-[14px]">A</div>
          Agency
        </a>
        <p class="text-[#A1B0C9] text-[15px] leading-relaxed max-w-sm mb-6">
          Создаем цифровые продукты, которые помогают бизнесу расти. Разработка, дизайн и маркетинг под ключ.
        </p>
        <div class="flex gap-3">
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-[#A1B0C9] hover:bg-[#1760F5] hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-[#A1B0C9] hover:bg-[#1760F5] hover:text-white transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.205 11.387.6.11.82-.26.82-.577v-2.234c-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.22.694.825.576C20.565 21.796 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-manrope font-bold text-[16px] text-white mb-5">Навигация</h3>
        <ul class="space-y-3 text-[14px]">
          <li><a href="/services" class="text-[#A1B0C9] hover:text-white transition-colors">Услуги</a></li>
          <li><a href="/blog" class="text-[#A1B0C9] hover:text-white transition-colors">Блог</a></li>
          <li><a href="/about" class="text-[#A1B0C9] hover:text-white transition-colors">О нас</a></li>
          <li><a href="/contact" class="text-[#A1B0C9] hover:text-white transition-colors">Контакты</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-manrope font-bold text-[16px] text-white mb-5">Контакты</h3>
        <ul class="space-y-3 text-[14px]">
          <li>
            <a href="mailto:hello@agency.ru" class="text-[#A1B0C9] hover:text-white transition-colors flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              hello@agency.ru
            </a>
          </li>
          <li>
            <a href="tel:+79991234567" class="text-[#A1B0C9] hover:text-white transition-colors flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +7 (999) 123-45-67
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[#78839A] text-[13px]">© {year} Agency. Все права защищены.</p>
    </div>
  </div>
</footer>