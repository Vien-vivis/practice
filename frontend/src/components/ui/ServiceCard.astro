---
import type { Service } from '../../lib/types';
import { blocksToHtml } from '../../lib/blocks';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---
<a href={`/services/${service.slug}`} class="group flex flex-col p-6 bg-white border border-[#E3E8F1] rounded-[20px] shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 h-full">
  
  <!-- Иконка (если есть в базе, иначе дефолтная) -->
  <div class="w-[56px] h-[56px] rounded-[14px] bg-[#EAF0FF] text-[#1760F5] flex items-center justify-center mb-6">
    {service.icon ? (
      <span class="text-2xl">{service.icon}</span>
    ) : (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M2 20h20" /></svg>
    )}
  </div>

  <!-- Заголовок -->
  <h3 class="font-manrope font-bold text-[19px] text-[#101D3A] mb-2 group-hover:text-[#1760F5] transition-colors">
    {service.title}
  </h3>

  <!-- Описание (парсим из Rich Text Strapi) -->
  <div class="text-[#78839A] text-[14px] leading-relaxed line-clamp-3 mb-6 flex-grow" set:html={blocksToHtml(service.description)} />

  <!-- Ссылка "Подробнее" -->
  <div class="mt-auto flex items-center text-[#1760F5] font-semibold text-[14px]">
    Подробнее
    <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
  </div>
</a>