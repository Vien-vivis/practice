---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  type?: 'button' | 'submit';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  href, variant = 'primary', type = 'button', size = 'md', class: cls = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium rounded-lg transition focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed';

const sizes = { md: 'px-5 py-2.5 text-sm', lg: 'px-6 py-3 text-base' };
const variants = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  outline: 'border border-blue-600 text-blue-600 hover:bg-blue-50',
  ghost: 'text-blue-600 hover:bg-blue-50',
};

const styles = `${base} ${sizes[size]} ${variants[variant]} ${cls}`;
---
{href ? (
  <a href={href} class={styles}><slot /></a>
) : (
  <button type={type} class={styles}><slot /></button>
)}