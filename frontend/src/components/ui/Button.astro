---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline';
  type?: 'button' | 'submit';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  href, variant = 'primary', type = 'button', size = 'md', class: cls = '',
} = Astro.props;

const base = 'inline-flex items-center justify-center font-inter font-semibold rounded-[12px] transition-colors focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed';
const sizes = { md: 'h-[40px] px-5 text-[14px]', lg: 'h-[48px] px-6 text-[15px]' };
const variants = {
  primary: 'bg-[#1760F5] text-white hover:bg-[#0D4ED8]',
  outline: 'bg-transparent border border-[#1760F5] text-[#1760F5] hover:bg-[#EAF0FF]',
};
const styles = `${base} ${sizes[size]} ${variants[variant]} ${cls}`;
---
{href ? (<a href={href} class={styles}><slot /></a>) : (<button type={type} class={styles}><slot /></button>)}