---
interface Props { href?: string; class?: string; }
const { href, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const base = 'block bg-white rounded-2xl border border-gray-200 p-6 transition hover:shadow-lg hover:-translate-y-0.5';
---
<Tag href={href} class={`${base} ${cls}`}><slot /></Tag>