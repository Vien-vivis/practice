---
import Card from '../ui/Card.astro';
import SmartImage from '../ui/SmartImage.astro';
import type { Post } from '../../lib/types';

interface Props {
  posts: Post[];
  title?: string;
}

const { posts, title = 'Последние статьи' } = Astro.props;

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('ru-RU', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
---
<section class="py-16 md:py-20 max-w-[1184px] mx-auto px-4 bg-white font-inter">
    {title && (
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="font-manrope font-extrabold text-[32px] text-[#101D3A] tracking-tight">{title}</h2>
        <p class="text-[#78839A] mt-2 text-[15px]">Экспертиза, кейсы и новости нашей студии</p>
      </div>
      <a href="/blog" class="text-[#1760F5] text-[15px] font-semibold hover:text-[#0D4ED8] flex items-center gap-2 transition-colors group">
        Все статьи 
        <span class="w-8 h-8 rounded-full bg-[#F4F7FF] border border-[#E3E8F1] flex items-center justify-center group-hover:bg-[#EAF0FF] transition-colors">→</span>
      </a>
    </div>
  )}

  {posts.length === 0 ? (
    <p class="text-[#78839A]">Пока нет статей.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((p) => {
        const cat = p.category?.[0];
        const auth = p.authors?.[0];
        return (
          <Card href={`/blog/${p.slug}`} class="group flex flex-col bg-white border border-[#E3E8F1] rounded-[20px] overflow-hidden hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-300">
            <div class="relative h-[180px] w-full bg-[#F4F7FF] overflow-hidden">
              <SmartImage media={p.cover} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" sizes="(max-width: 768px) 100vw, 33vw" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
              {cat && (
                <div class="absolute top-4 left-4">
                  <span class="bg-white/95 backdrop-blur-sm text-[#101D3A] text-[12px] font-bold px-3 py-1.5 rounded-[8px] shadow-sm uppercase tracking-wider">{cat.name}</span>
                </div>
              )}
            </div>
            <div class="p-6 flex-grow flex flex-col">
              <div class="flex items-center gap-3 text-[12px] font-medium text-[#78839A] mb-3">
                <span>{fmt(p.publishedAt)}</span>
                {auth && (<><span class="w-1 h-1 rounded-full bg-[#E3E8F1]"></span><span>{auth.name}</span></>)}
              </div>
              <h3 class="font-manrope font-bold text-[18px] text-[#101D3A] mb-2 leading-tight group-hover:text-[#1760F5] transition-colors line-clamp-2">{p.title}</h3>
              {p.excerpt && <p class="text-[#78839A] text-[14px] line-clamp-2 leading-relaxed">{p.excerpt}</p>}
            </div>
          </Card>
        );
      })}
    </div>
  )}
</section>