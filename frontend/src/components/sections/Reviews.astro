---
import { getReviews } from '../../lib/api';
const reviews = await getReviews();
---
<section class="py-16 max-w-[1184px] mx-auto px-4 font-inter">
  <h2 class="font-manrope font-extrabold text-3xl text-[#101D3A] mb-8">Отзывы клиентов</h2>

  <!-- Форма добавления отзыва (скрыта, если не авторизован) -->
  <div id="add-review-box" class="hidden bg-white p-6 rounded-[20px] border border-[#E3E8F1] shadow-sm mb-8">
    <h3 class="font-bold text-lg text-[#101D3A] mb-4">Оставить отзыв</h3>
    <form id="review-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1">Оценка (1-5)</label>
        <input type="number" id="rating" min="1" max="5" required class="w-full border border-gray-300 rounded-lg px-4 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Текст отзыва</label>
        <textarea id="review-text" rows="3" required class="w-full border border-gray-300 rounded-lg px-4 py-2"></textarea>
      </div>
      <button type="submit" class="bg-[#1760F5] text-white px-6 py-2 rounded-[10px] font-semibold">Отправить</button>
      <p id="review-status" class="text-sm font-medium"></p>
    </form>
  </div>

  <!-- Список отзывов -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {reviews.length === 0 ? (
      <p class="text-[#78839A]">Пока нет отзывов. Будьте первым!</p>
    ) : (
      reviews.map((r: any) => (
        <div class="bg-white p-6 rounded-[20px] border border-[#E3E8F1] shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-yellow-400 text-lg">{'★'.repeat(r.attributes?.rating || r.rating)}</span>
            <span class="font-bold text-[#101D3A]">
  {r.users_permissions_user?.username || 'Аноним'}
</span>
          </div>
          <p class="text-[#35415B] text-sm leading-relaxed">{r.attributes?.text || r.text}</p>
        </div>
      ))
    )}
  </div>
</section>

<script>
  import { translateStrapiError } from '../../lib/errors';

    const token = localStorage.getItem('jwt');
  const userStr = localStorage.getItem('user');
  let userDocId = localStorage.getItem('userDocumentId');

  // Страховка: если documentId не сохранен отдельно, берем его из объекта user
  if (!userDocId && userStr) {
    try {
      const parsedUser = JSON.parse(userStr);
      userDocId = parsedUser.documentId;
    } catch (e) {}
  }
  
  const addBox = document.getElementById('add-review-box');
  
  if (token && addBox) {
    addBox.classList.remove('hidden');
  }

  const form = document.getElementById('review-form');
  const status = document.getElementById('review-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!token || !userDocId) {
        status.textContent = 'Ошибка: вы не авторизованы или сессия устарела.';
        status.className = 'text-sm text-red-500';
        return;
      }

      const ratingInput = document.getElementById('rating');
      const textInput = document.getElementById('review-text');
      
      const rating = Number(ratingInput.value);
      const text = textInput.value;

      status.textContent = 'Отправка...';
      status.className = 'text-sm text-gray-500';
      const base = import.meta.env.PUBLIC_STRAPI_URL || 'http://localhost:1337';

      try {
        // Отправляем ОДИН запрос с привязкой по documentId
        const res = await fetch(base + '/api/reviews', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: 'Bearer ' + token,
          },
          body: JSON.stringify({ 
            data: { 
              text: text, 
              rating: rating,
              users_permissions_user: userDocId // Передаем documentId, а не id
            } 
          }),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(translateStrapiError(err.error?.message || 'Ошибка'));
        }

        status.textContent = 'Спасибо за отзыв!';
        status.className = 'text-sm text-green-600';
        
        setTimeout(() => window.location.reload(), 1000);
      } catch (err) {
        status.textContent = err.message;
        status.className = 'text-sm text-red-500';
      }
    });
  }
</script>