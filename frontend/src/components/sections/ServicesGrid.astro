---
import Card from '../ui/Card.astro';
import type { Service } from '../../lib/types';
import { blocksToHtml } from '../../lib/blocks';
import { blocksToHtml } from '../../lib/blocks';

interface Props {
  services: Service[];
  title?: string;
}

const { services, title = 'Наши услуги' } = Astro.props;
---
<section class="py-16 md:py-20 max-w-6xl mx-auto px-4">
  <h2 class="text-3xl md:text-4xl font-bold mb-10">{title}</h2>

  {services.length === 0 ? (
    <p class="text-gray-500">Пока нет услуг.</p>
  ) : (
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <Card href={`/services/${s.slug}`}>
          {s.icon && <div class="text-3xl mb-3">{s.icon}</div>}
          <h3 class="font-semibold text-lg mb-2">{s.title}</h3>
          <div class="text-gray-600 text-sm line-clamp-3" set:html={blocksToHtml(s.description)} />
        </Card>
      ))}
    </div>
  )}
</section>