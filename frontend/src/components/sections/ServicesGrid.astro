---
import Card from '../ui/Card.astro';
import type { Service } from '../../lib/types';
import { blocksToHtml } from '../../lib/blocks';

interface Props {
  services: Service[];
  title?: string;
}

const { services, title = 'Наши услуги' } = Astro.props;
---
<section class="py-12 md:py-16 max-w-[1184px] mx-auto px-4 font-inter">
  
  <!-- Заголовок секции (выводим, если передан) -->
  {title && (
    <div class="flex items-center gap-3 mb-8">
      <span class="w-[24px] h-[2px] bg-[#1760F5] inline-block"></span>
      <h2 class="font-manrope font-bold text-[28px] text-[#101D3A]">{title}</h2>
    </div>
  )}

  {services.length === 0 ? (
    <div class="text-center py-12">
      <p class="text-[#78839A] text-lg">Пока нет доступных услуг.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s, i) => (
        <Card href={`/services/${s.slug}`} class="group flex flex-col p-8 border border-[#E3E8F1] bg-white rounded-[20px] shadow-sm hover:shadow-[0_15px_30px_-10px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-300">
          
          <!-- Иконка -->
          <div class="w-[56px] h-[56px] rounded-[14px] bg-gradient-to-br from-[#1760F5] to-[#3B82F6] flex items-center justify-center text-white shadow-md shadow-blue-500/20 mb-6">
            {i === 0 && (<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M2 20h20" /></svg>)}
            {i === 1 && (<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>)}
            {i === 2 && (<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>)}
            {i > 2 && (<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>)}
          </div>
          
          <!-- Текст -->
          <h3 class="font-manrope font-bold text-[20px] text-[#101D3A] mb-3 group-hover:text-[#1760F5] transition-colors">{s.title}</h3>
          <div class="text-[#78839A] text-[15px] leading-relaxed line-clamp-4 mb-6 flex-grow" set:html={blocksToHtml(s.description)} />
          
          <!-- Кнопка "Подробнее" -->
          <div class="mt-auto flex items-center text-[#1760F5] font-semibold text-[15px]">
            Подробнее <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </Card>
      ))}
    </div>
  )}
</section>