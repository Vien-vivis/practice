---
import Layout from '../../layouts/Layout.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import Badge from '../../components/ui/Badge.astro';
import type { Post } from '../../lib/types';
import { getPost, safeLoad } from '../../lib/api';
import { blocksToHtml } from '../../lib/blocks';

// output: 'server' — статья запрашивается на каждый запрос (getStaticPaths не нужен).
const slug = Astro.params.slug;
const { data: post, failed } = await safeLoad<Post | null>(
  () => (slug ? getPost(slug) : Promise.resolve(null)),
  null,
);

if (!post) {
  // 503 — если упал сам API, 404 — если статьи с таким slug просто нет.
  Astro.response.status = failed ? 503 : 404;
}

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('ru-RU', {
    day: 'numeric', month: 'long', year: 'numeric',
  });

const author = post?.authors?.[0];
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.title,
      image: post.cover?.url,
      datePublished: post.publishedAt,
      author: author ? { '@type': 'Person', name: author.name } : undefined,
    }
  : undefined;
---
{post ? (
  <Layout
    title={`${post.title} — Agency`}
    description={post.excerpt ?? undefined}
    ogImage={post.cover?.url}
    jsonLd={jsonLd}
  >
    <article class="max-w-3xl mx-auto px-4 py-16">
      <a href="/blog" class="text-sm text-blue-600 hover:underline">← Все статьи</a>

      <div class="mt-4 flex items-center gap-3">
        {post.category?.[0] && <Badge>{post.category[0].name}</Badge>}
        <span class="text-sm text-gray-500">{fmt(post.publishedAt)}</span>
      </div>

      <h1 class="text-4xl font-bold mt-4 mb-6">{post.title}</h1>

      {post.cover && (
        <SmartImage media={post.cover}
                    class="w-full rounded-2xl mb-8 aspect-video object-cover" eager />
      )}

      <div class="prose" set:html={blocksToHtml(post.content)} />

      {author && (
        <div class="mt-10 pt-6 border-t flex items-center gap-4">
          <div>
            <p class="font-semibold">{author.name}</p>
            {author.bio && (
              <p class="text-sm text-gray-600">{author.bio}</p>
            )}
          </div>
        </div>
      )}
    </article>
  </Layout>
) : (
  <Layout title="Статья не найдена — Agency">
    <section class="max-w-2xl mx-auto px-4 py-24 text-center">
      <h1 class="text-6xl font-bold mb-4">404</h1>
      <p class="text-gray-600 mb-8">{failed ? 'API временно недоступен, попробуйте позже.' : 'Такой статьи нет.'}</p>
      <a href="/blog" class="text-blue-600 hover:underline">← Все статьи</a>
    </section>
  </Layout>
)}
